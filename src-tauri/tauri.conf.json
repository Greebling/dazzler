{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dazzler",
  "mainBinaryName": "Dazzler",
  "identifier": "unofficial.dazzler",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Greebling",
    "shortDescription": "Unofficial desktop client for deezer.com",
    "longDescription": "An unofficial desktop wrapper around the deezer.com web player. Not affiliated with, endorsed by or supported by Deezer.",
    "copyright": "",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "targets": ["nsis", "deb", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
