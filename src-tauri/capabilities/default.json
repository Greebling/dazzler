{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the injected settings tab (settings.js) on deezer.com toggle autostart.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://www.deezer.com/*"]
  },
  "permissions": [
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
